---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="JSON">
<main class="min-h-screen flex items-center justify-center px-4 py-8">
<div class="w-full max-w-md bg-card border border-border rounded-xl p-6">
<h1 class="text-2xl font-bold text-foreground mb-4 text-center">JSON formatear</h1>
<textarea id="in" rows="6" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"></textarea>
<div class="flex gap-2 mb-3">
<button id="fmt" class="px-3 py-2 bg-primary text-primary-foreground rounded-lg">Formatear</button>
<button id="min" class="px-3 py-2 bg-secondary text-secondary-foreground rounded-lg">Minificar</button>
</div>
<textarea id="out" readonly rows="6" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"></textarea>
<p id="err" class="text-red-500 text-sm mt-2"></p>
</div></main>
<script is:inline>
const i=document.getElementById('in'),o=document.getElementById('out'),e=document.getElementById('err');
function run(space){try{const j=JSON.parse(i.value);o.value=JSON.stringify(j,null,space);e.textContent='';}catch(err){o.value='';e.textContent=err.message;}}
document.getElementById('fmt').onclick=()=>run(2);
document.getElementById('min').onclick=()=>run(0);
</script>
</Layout>