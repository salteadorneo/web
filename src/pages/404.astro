---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <Header />
  <main class="grid place-content-center px-6 py-24">
    <section class="w-full max-w-md border border-border bg-card p-8">
      <p class="text-xs text-muted-foreground flex items-center gap-2">
        <span class="text-primary">❯</span> cat ~/404
      </p>
      <h1 class="mt-4 text-7xl font-black text-primary">404</h1>
      <p class="mt-2 text-muted-foreground">Página no encontrada</p>
      <a
        href="/"
        class="mt-6 inline-block text-sm text-primary hover:underline underline-offset-4"
        >$ cd ~</a
      >
    </section>
  </main>
  <Footer />
</Layout>
