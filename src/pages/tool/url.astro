---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="URL">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">
        URL encode/decode
      </h1>
      <textarea
        id="in"
        rows="4"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"
      ></textarea>
      <div class="flex gap-2 mb-3">
        <button
          id="enc"
          class="px-3 py-2 bg-primary text-primary-foreground rounded-lg"
        >
          Encode
        </button>
        <button
          id="dec"
          class="px-3 py-2 bg-secondary text-secondary-foreground rounded-lg"
        >
          Decode
        </button>
      </div>
      <textarea
        id="out"
        readonly
        rows="4"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"
      ></textarea>
    </div>
  </main>
  <script is:inline>
    const i = document.getElementById("in"),
      o = document.getElementById("out");
    document.getElementById("enc").onclick = () => {
      o.value = encodeURIComponent(i.value);
    };
    document.getElementById("dec").onclick = () => {
      try {
        o.value = decodeURIComponent(i.value);
      } catch (e) {
        o.value = "Error";
      }
    };
  </script>
</ToolsLayout>
