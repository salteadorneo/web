---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="XSS Play" description="Playground XSS con sanitizer (DOMPurify CDN)">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">XSS Playground</h1>
      <textarea id="in" rows="4" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3" placeholder="<img src=x onerror=alert(1)>"></textarea>
      <button id="run" class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3">Render (sanitized)</button>
      <div id="out" class="border border-border rounded-lg p-3 min-h-[60px] bg-background"></div>
    </div>
  </main>
  <script is:inline src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
  <script is:inline>
    document.getElementById("run").onclick = () => {
      const raw = document.getElementById("in").value;
      document.getElementById("out").innerHTML = window.DOMPurify ? DOMPurify.sanitize(raw) : raw;
    };
  </script>
</ToolsLayout>
