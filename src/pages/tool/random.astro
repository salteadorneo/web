---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="Rand">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">
        Números aleatorios
      </h1>
      <div class="flex gap-2 mb-3">
        <label class="w-1/3 text-xs text-muted-foreground">
          Mínimo
          <input
            id="min"
            type="number"
            value="1"
            class="w-full px-2 py-2 bg-background border border-border rounded-lg text-foreground"
          />
        </label>
        <label class="w-1/3 text-xs text-muted-foreground">
          Máximo
          <input
            id="max"
            type="number"
            value="100"
            class="w-full px-2 py-2 bg-background border border-border rounded-lg text-foreground"
          />
        </label>
        <label class="w-1/3 text-xs text-muted-foreground">
          Cantidad
          <input
            id="count"
            type="number"
            value="5"
            class="w-full px-2 py-2 bg-background border border-border rounded-lg text-foreground"
          />
        </label>
      </div>
      <button
        id="gen"
        class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3"
      >
        Generar
      </button>
      <textarea
        id="out"
        readonly
        rows="6"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"
      ></textarea>
    </div>
  </main>
  <script is:inline>
    const mn = document.getElementById("min"),
      mx = document.getElementById("max"),
      c = document.getElementById("count"),
      o = document.getElementById("out");
    document.getElementById("gen").onclick = () => {
      const a = +mn.value,
        b = +mx.value,
        n = +c.value;
      const r = [];
      for (let i = 0; i < n; i++)
        r.push(Math.floor(Math.random() * (b - a + 1)) + a);
      o.value = r.join("\n");
    };
    document.getElementById("gen").click();
  </script>
</ToolsLayout>
