---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="Ports" description="Comprobador de puertos (limitado por navegador)">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">Port Checker</h1>
      <p class="text-xs text-muted-foreground mb-3 text-center">
        Limitado por el navegador/CORS. Solo indica si el puerto responde (best-effort). Usa API externa (ipify.org) para obtener tu IP.
      </p>
      <div class="flex gap-2 mb-3">
        <input id="host" placeholder="host" class="flex-1 px-3 py-2 bg-background border border-border rounded-lg text-foreground" />
        <select id="preset" class="px-3 py-2 bg-background border border-border rounded-lg text-foreground">
          <option value="common">Comunes</option>
          <option value="web">Web</option>
          <option value="db">BBDD</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <input id="ports" placeholder="80,443,8080" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3" />
      <button id="run" class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3">Comprobar</button>
      <textarea id="out" rows="12" readonly class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"></textarea>
    </div>
  </main>
  <script is:inline>
    async function check(host, port) {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 3000);
      const start = performance.now();
      try {
        await fetch("http://" + host + ":" + port, { mode: "no-cors", signal: ctrl.signal });
        clearTimeout(t);
        return "abierto/respuesta (" + Math.round(performance.now()-start) + "ms)";
      } catch (e) {
        clearTimeout(t);
        const msg = String(e.message || e);
        if (msg.includes("abort") || msg.includes("timeout")) return "timeout/filtrado";
        return "cerrado/error";
      }
    }
    const presets = {
      common: "21,22,23,25,53,80,110,143,443,445,3306,3389,5432,6379,8080,8443",
      web: "80,443,8080,8443,8000,3000,5000",
      db: "3306,5432,1433,27017,6379,1521",
    };
    const host = document.getElementById("host");
    const ports = document.getElementById("ports");
    const preset = document.getElementById("preset");
    preset.addEventListener("change", () => {
      if (preset.value !== "custom") ports.value = presets[preset.value];
    });
    ports.value = presets.common;
    (async () => {
      try {
        const r = await fetch("https://api.ipify.org?format=json");
        const j = await r.json();
        host.value = j.ip;
      } catch (e) {
        host.value = "127.0.0.1";
      }
    })();
    document.getElementById("run").onclick = async () => {
      const h = document.getElementById("host").value.trim();
      const ports = document.getElementById("ports").value.split(",").map(s=>s.trim()).filter(Boolean);
      const out = document.getElementById("out");
      out.value = "";
      for (const p of ports) {
        out.value += h + ":" + p + " -> " + await check(h, p) + "\n";
      }
    };
  </script>
</ToolsLayout>
