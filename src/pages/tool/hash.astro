---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="Hash">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">Hash</h1>
      <textarea
        id="in"
        rows="3"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"
      ></textarea>
      <select
        id="algo"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"
      >
        <option>SHA-1</option>
        <option selected>SHA-256</option>
        <option>SHA-384</option>
        <option>SHA-512</option>
      </select>
      <button
        id="run"
        class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3"
      >
        Calcular
      </button>
      <input
        id="out"
        readonly
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"
      />
    </div>
  </main>
  <script is:inline>
    const i = document.getElementById("in"),
      a = document.getElementById("algo"),
      o = document.getElementById("out");
    document.getElementById("run").onclick = async () => {
      const buf = await crypto.subtle.digest(
        a.value,
        new TextEncoder().encode(i.value),
      );
      o.value = [...new Uint8Array(buf)]
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    };
  </script>
</ToolsLayout>
