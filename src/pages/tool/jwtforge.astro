---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="JWT Forge" description="Firmar JWT con secret conocido (HS256)">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">JWT Forge</h1>
      <textarea id="payload" rows="4" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm mb-3" placeholder='{"sub":"123","role":"admin"}'></textarea>
      <input id="secret" placeholder="secret" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3" />
      <button id="run" class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3">Firmar</button>
      <textarea id="out" rows="3" readonly class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"></textarea>
    </div>
  </main>
  <script is:inline>
    function b64url(buf) {
      return btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
    }
    document.getElementById("run").onclick = async () => {
      const payload = JSON.parse(document.getElementById("payload").value || "{}");
      const secret = document.getElementById("secret").value;
      const header = { alg: "HS256", typ: "JWT" };
      const enc = new TextEncoder();
      const h = btoa(JSON.stringify(header)).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
      const p = btoa(JSON.stringify(payload)).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
      const key = await crypto.subtle.importKey("raw", enc.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
      const sig = await crypto.subtle.sign("HMAC", key, enc.encode(h + "." + p));
      document.getElementById("out").value = h + "." + p + "." + b64url(sig);
    };
  </script>
</ToolsLayout>
