---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="Slug">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-card border border-border rounded-xl p-6">
      <h1 class="text-2xl font-bold text-foreground mb-4 text-center">Slug</h1>
      <input
        id="in"
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"
      />
      <input
        id="out"
        readonly
        class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono"
      />
    </div>
  </main>
  <script is:inline>
    const i = document.getElementById("in"),
      o = document.getElementById("out");
    function slugify(s) {
      return s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");
    }
    i.addEventListener("input", () => {
      o.value = slugify(i.value);
    });
  </script>
</ToolsLayout>
