---
import ToolsLayout from "@/layouts/ToolsLayout.astro";
---

<ToolsLayout title="CORS" description="Tester de CORS">
  <main class="min-h-0 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
      <p class="text-xs text-muted-foreground mb-3 text-center">
        Realiza peticiones a la URL indicada (puede fallar por CORS).
      </p>
      <input id="url" placeholder="https://api.example.com/data" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3" />
      <button id="run" class="px-3 py-2 bg-primary text-primary-foreground rounded-lg mb-3">Probar</button>
      <textarea id="out" rows="12" readonly class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground font-mono text-sm"></textarea>
    </div>
  </main>
  <script is:inline>
    document.getElementById("run").onclick = async () => {
      const url = document.getElementById("url").value;
      const out = document.getElementById("out");
      out.value = "Probando...";
      try {
        const r = await fetch(url, { mode: "cors" });
        const text = await r.text();
        out.value = "Status: " + r.status + "\n\nHeaders:\n" + [...r.headers.entries()].map(([k,v])=>k+": "+v).join("\n") + "\n\nBody:\n" + text.slice(0,2000);
      } catch (e) {
        out.value = "Error (posible CORS bloqueado): " + e.message;
      }
    };
  </script>
</ToolsLayout>
