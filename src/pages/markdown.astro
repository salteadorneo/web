---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Markdown">
<main class="min-h-screen flex items-center justify-center px-4 py-8">
<div class="w-full max-w-2xl bg-card border border-border rounded-xl p-6">
<h1 class="text-2xl font-bold text-foreground mb-4 text-center">Markdown preview</h1>
<textarea id="in" rows="8" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-3"></textarea>
<div id="out" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-foreground prose min-h-[8rem]"></div>
</div></main>
<script is:inline>
const i=document.getElementById('in'),o=document.getElementById('out');
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function md(s){
  s=esc(s);
  s=s.replace(/^### (.*)$/gm,'<h3>$1</h3>');
  s=s.replace(/^## (.*)$/gm,'<h2>$1</h2>');
  s=s.replace(/^# (.*)$/gm,'<h1>$1</h1>');
  s=s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  s=s.replace(/\*(.+?)\*/g,'<em>$1</em>');
  s=s.replace(/`(.+?)`/g,'<code>$1</code>');
  s=s.replace(/\[(.+?)\]\((.+?)\)/g,'<a href="$2">$1</a>');
  s=s.replace(/^- (.*)$/gm,'<li>$1</li>');
  s=s.replace(/(<li>.*<\/li>\n?)+/g,'<ul>$&</ul>');
  s=s.replace(/\n\n/g,'</p><p>');
  return '<p>'+s+'</p>';
}
function run(){o.innerHTML=md(i.value);}
i.addEventListener('input',run);run();
</script>
</Layout>