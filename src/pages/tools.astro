---
import ToolsLayout from "@/layouts/ToolsLayout.astro";

const groups = [
  {
    name: "Generadores",
    items: [
      ["/tool/pass", "Pass"],
      ["/tool/lipsum", "Lipsum"],
      ["/tool/uuid", "UUID"],
      ["/tool/random", "Rand"],
    ],
  },
  {
    name: "Texto",
    items: [
      ["/tool/base64", "Base64"],
      ["/tool/url", "URL"],
      ["/tool/slug", "Slug"],
      ["/tool/case", "Case"],
      ["/tool/markdown", "MD"],
    ],
  },
  {
    name: "Datos",
    items: [
      ["/tool/json", "JSON"],
      ["/tool/hash", "Hash"],
      ["/tool/color", "Color"],
      ["/tool/timestamp", "Time"],
      ["/tool/jwt", "JWT"],
    ],
  },
  {
    name: "Desarrollo",
    items: [
      ["/tool/regex", "Regex"],
      ["/tool/diff", "Diff"],
      ["/tool/cron", "Cron"],
    ],
  },
  {
    name: "Seguridad",
    items: [
      ["/tool/payloads", "Payloads"],
      ["/tool/subdomains", "Subdomains"],
      ["/tool/breach", "Breach"],
      ["/tool/hashid", "HashID"],
      ["/tool/csp", "CSP"],
      ["/tool/revshell", "RevShell"],
      ["/tool/encoder", "Encoder"],
      ["/tool/jwtforge", "JWT Forge"],
      ["/tool/recon", "Recon"],
      ["/tool/xssplay", "XSS Play"],
      ["/tool/fuzzer", "Fuzzer"],
      ["/tool/corstest", "CORS"],
      ["/tool/myip", "My IP"],
    ],
  },
];
---

<ToolsLayout
  title="Herramientas"
  description="Colección de herramientas web gratuitas"
>
  <main class="max-w-4xl mx-auto px-6 py-10">
    {groups.map((g) => (
      <section class="mb-8">
        <h2 class="text-xs uppercase tracking-widest text-muted-foreground mb-3">
          {g.name}
        </h2>
        <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {g.items.map(([href, label]) => (
            <li>
              <a
                href={href}
                class="block border border-border bg-card px-4 py-3 text-sm text-foreground hover:border-primary/60 transition-colors text-center"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</ToolsLayout>
