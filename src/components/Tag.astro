---
import { slugify } from "@/utils.js";

const { tag } = Astro.props;
---

<a
  href={`/blog/tag/${slugify(tag)}/`}
  class="inline-flex items-center border border-border bg-secondary/60 px-2.5 py-1 text-xs text-muted-foreground text-nowrap transition-colors hover:border-primary/60 hover:text-primary"
>
  #{tag}
</a>
